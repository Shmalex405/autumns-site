---
import Base from '../layouts/Base.astro';
import { SITE, STATS } from '../data/site.mjs';

// Media kit p.4, "This is me. Hope it's you, too!" — verbatim.
const THIS_IS_ME = [
  'Can’t go anywhere without my camera',
  'I believe sunshine is the cure for everything',
  'Shopping local is always a good idea',
  'If you ask if I want to go to early morning pilates and grab chai after, the answer is always yes!!',
];
---
<Base
  title="About"
  description="Autumn Flowers is a content creator, videographer and mom of three in St. George, Utah, creating authentic video for businesses across Southern Utah."
>
  <section class="intro">
    <div class="wrap intro__in">
      <div class="intro__body">
        <p class="eyebrow">About</p>
        <h1>Hi, I&rsquo;m<br /><em>Autumn</em>.</h1>
        <p class="lede">
          Content creator, storyteller, and mom of three little ones &mdash; including
          twin boys &mdash; living in sunny St. George, Utah.
        </p>
      </div>
      <div class="intro__media">
        <img src="/img/autumn-about.jpg" alt="Autumn Flowers in St. George, Utah"
          width="900" height="1350" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap wrap--narrow">
      <div class="prose">
        <p class="prose__lead">
          I share family-friendly businesses, products and experiences that make life
          easier, more fun and more memorable for parents.
        </p>
        <p>
          Whether we&rsquo;re exploring local adventures, testing out products, or sharing
          everyday moments, my goal is to create authentic content that feels relatable
          and trustworthy. Not an ad that happens to feature your product &mdash; a
          recommendation that happens to be filmed well.
        </p>
        <p>
          As a busy mom of 3 under 3, I&rsquo;m always looking for brands, services and
          products that genuinely simplify family life. I love turning those discoveries
          into engaging video content that helps businesses connect with parents in a
          natural, meaningful way.
        </p>
        <p>
          That&rsquo;s really the heart of it. I&rsquo;m a lot like the people watching &mdash;
          juggling three kids, shopping local, always after something that makes the week
          a little easier. So when I say something is good, it lands, because I&rsquo;m not
          performing an enthusiasm I don&rsquo;t actually have.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap">
      <div class="me">
        <div class="me__list">
          <p class="eyebrow">This is me. Hope it&rsquo;s you, too!</p>
          <ul>{THIS_IS_ME.map(t => <li>{t}</li>)}</ul>
        </div>
        <div class="me__img">
          <img src="/img/autumn-joy.jpg" alt="Autumn Flowers with her arms in the air under a blue sky"
            width="1200" height="800" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">The audience</p>
        <h2>Who&rsquo;s<br /><em>watching</em>.</h2>
        <p class="lede">
          Straight from Instagram &mdash; this is who sees your content when we work together.
        </p>
      </div>
      <div class="stats">
        {STATS.map(s => (
          <div class="stat">
            <p class="stat__v">{s.value}</p>
            <p class="stat__l">{s.label}</p>
            <p class="stat__n">{s.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sage">
    <div class="wrap wrap--narrow" style="text-align:center">
      <h2 style="color:#fff">Let&rsquo;s <em style="color:var(--cream)">team up</em>!</h2>
      <p class="lede" style="margin:1.2rem auto 2rem">
        I&rsquo;d love to hear what you&rsquo;re working on.
      </p>
      <div class="btn-row" style="justify-content:center">
        <a href="/contact/" class="btn btn--onsage">Get in touch</a>
        <a href={SITE.handleUrl} class="btn btn--light" rel="noopener" target="_blank">{SITE.handleLabel}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 4rem); }
  .intro__in { display: grid; grid-template-columns: 1fr .85fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .intro__body h1 { margin-bottom: 1.4rem; }
  .intro__media img { width: 100%; aspect-ratio: 2/3; object-fit: cover; border-radius: var(--radius); }
  @media (max-width: 820px) {
    .intro__in { grid-template-columns: 1fr; }
    .intro__media { order: -1; }
    .intro__media img { aspect-ratio: 4/3; object-position: center 22%; }
  }

  .prose__lead { font-family: var(--display); font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.28; color: var(--ink); margin-bottom: 1.6rem; }
  .prose p:not(.prose__lead) { color: var(--muted); font-size: 1.05rem; }

  .me { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .me__list ul { list-style: none; margin: 0; padding: 0; }
  .me__list li { padding: 1.1rem 0 1.1rem 2.2rem; position: relative;
    border-bottom: 1px solid var(--line); font-size: 1.05rem; }
  .me__list li:last-child { border-bottom: 0; }
  /* The media kit marks these with a sage quarter-round; this echoes it. */
  .me__list li::before { content: ''; position: absolute; left: 0; top: 1.35rem;
    width: 12px; height: 12px; background: var(--sage); border-radius: 12px 0 0 0; }
  .me__img img { width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: var(--radius); }
  @media (max-width: 800px) { .me { grid-template-columns: 1fr; } }
</style>
