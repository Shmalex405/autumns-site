---
import Base from '../layouts/Base.astro';
import { UGC_PACKAGES, CONTENT_DAY, ADD_ONS } from '../data/site.mjs';
---
<Base
  title="Pricing"
  description="UGC packages from $125, content days from $250/hour, FPV drone from $400/hour. Published rates, no discovery call required."
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Pricing</p>
      <h1>What it <em>costs</em>.</h1>
      <p class="lede">
        Right here on the site, so you can see what fits before you reach out. There are
        two ways to work together, depending on whether you&rsquo;d like my audience or
        you&rsquo;d like the footage.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="track">
        <p class="eyebrow">Track one &middot; UGC packages</p>
        <h2>I create it,<br />and I <em>post it</em>.</h2>
        <p class="lede">
          Content goes out to my audience on <a href="https://www.instagram.com/stgeorgemama/" rel="noopener" target="_blank">@stgeorgemama</a>
          &mdash; 11.5K average weekly reach, 40.4% of it here in St. George.
        </p>
      </div>

      <div class="tiers">
        {UGC_PACKAGES.map(p => (
          <article class={`tier${p.popular ? ' tier--pop' : ''}`}>
            {p.popular && <span class="tier__flag">Most booked</span>}
            <h3>{p.name}</h3>
            <p class="tier__price"><span>$</span>{p.price}</p>
            <ul>{p.features.map(f => <li>{f}</li>)}</ul>
            <a href={`/contact/?package=${p.name.toLowerCase()}`}
              class={`btn ${p.popular ? 'btn--solid' : 'btn--ghost'} tier__btn`}>Book {p.name}</a>
          </article>
        ))}
      </div>
      <p class="fine">
        For custom packages or specific collaboration inquiries, please reach out directly.
      </p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap">
      <div class="track">
        <p class="eyebrow">Track two &middot; Content day</p>
        <h2>You keep<br />the <em>footage</em>.</h2>
        <p class="lede">
          High-quality content your team can edit and share on your own terms. Raw files
          delivered within 24&ndash;48 hours.
        </p>
      </div>

      <div class="days">
        {CONTENT_DAY.map(d => (
          <article class="day">
            <h3>{d.name}</h3>
            <p class="day__price">{d.price}<span>{d.unit}</span></p>
            <p class="day__blurb">{d.blurb}</p>
            <ul>{d.features.map(f => <li>{f}</li>)}</ul>
          </article>
        ))}
      </div>

      <div class="addons">
        <h3>Add-ons</h3>
        <ul>
          {ADD_ONS.map(a => (
            <li><span>{a.name}</span><span class="addons__p">{a.price}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap--narrow" style="text-align:center">
      <h2>Something <em>custom</em> in mind?</h2>
      <p class="lede" style="margin:1.2rem auto 2rem">
        These packages are a starting point rather than a rule. If you have something
        different in mind, I put together custom collaborations all the time &mdash; just ask.
      </p>
      <div class="btn-row" style="justify-content:center">
        <a href="/contact/" class="btn btn--rock">Get in touch</a>
        <a href="/media-kit.pdf" class="btn btn--ghost" download>Download media kit</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem); }
  .page-head h1 { margin-bottom: 1.3rem; }
  .page-head .lede { max-width: 54ch; }

  .track { max-width: 46ch; margin-bottom: clamp(2.2rem, 4vw, 3.2rem); }
  .track h2 { margin-bottom: 1.1rem; }

  .tiers { display: grid; gap: 1.4rem; grid-template-columns: repeat(auto-fit, minmax(258px, 1fr)); align-items: start; }
  .tier { border: 1px solid var(--line); border-radius: var(--radius);
    padding: clamp(1.7rem, 3vw, 2.3rem); background: var(--paper); position: relative;
    display: flex; flex-direction: column; height: 100%; }
  .tier--pop { border-color: var(--sage); border-width: 2px; }
  .tier__flag { position: absolute; top: -.7rem; left: clamp(1.7rem, 3vw, 2.3rem);
    background: var(--sage); color: #fff; font-size: .6rem; font-weight: 600;
    letter-spacing: .16em; text-transform: uppercase; padding: .3rem .8rem; border-radius: 999px; }
  .tier h3 { font-size: 1.6rem; margin-bottom: .3rem; }
  .tier__price { font-family: var(--display); font-size: 3.4rem; line-height: 1; font-weight: 300;
    color: var(--rock); margin: 0 0 1.4rem; letter-spacing: -.02em;
    font-variant-numeric: lining-nums tabular-nums; font-feature-settings: 'lnum' 1, 'tnum' 1; }
  .tier__price span { font-size: 1.6rem; vertical-align: super; margin-right: 2px; }
  .tier ul { list-style: none; margin: 0 0 1.8rem; padding: 0; flex: 1; }
  .tier li { padding: .6rem 0 .6rem 1.5rem; position: relative; font-size: .94rem;
    color: var(--muted); border-bottom: 1px solid var(--line); }
  .tier li:last-child { border-bottom: 0; }
  .tier li::before { content: ''; position: absolute; left: 0; top: 1.05rem;
    width: 6px; height: 6px; border-radius: 50%; background: var(--sage); }
  .tier__btn { justify-content: center; }
  .fine { margin-top: 1.6rem; font-size: .86rem; color: var(--muted); font-style: italic; }

  .days { display: grid; gap: 1.4rem; grid-template-columns: repeat(auto-fit, minmax(258px, 1fr)); align-items: start; }
  .day { background: var(--paper); border-radius: var(--radius); padding: clamp(1.7rem, 3vw, 2.3rem); }
  .day h3 { font-size: 1.45rem; margin-bottom: .4rem; }
  .day__price { font-family: var(--display); font-size: 2.6rem; line-height: 1; font-weight: 300;
    color: var(--rock); margin: 0 0 .9rem; letter-spacing: -.02em;
    font-variant-numeric: lining-nums; font-feature-settings: 'lnum' 1; }
  .day__price span { font-family: var(--sans); font-size: .8rem; color: var(--muted);
    letter-spacing: .1em; text-transform: uppercase; margin-left: .4rem; }
  .day__blurb { font-style: italic; color: var(--brown); font-size: .94rem; margin-bottom: 1.1rem; }
  .day ul { list-style: none; margin: 0; padding: 0; }
  .day li { padding: .55rem 0 .55rem 1.5rem; position: relative; font-size: .92rem;
    color: var(--muted); }
  .day li::before { content: ''; position: absolute; left: 0; top: 1rem;
    width: 6px; height: 6px; border-radius: 50%; background: var(--sage); }

  .addons { margin-top: 2.6rem; background: var(--paper); border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2rem); max-width: 560px; }
  .addons h3 { font-size: 1.2rem; margin-bottom: .8rem; }
  .addons ul { list-style: none; margin: 0; padding: 0; }
  .addons li { display: flex; justify-content: space-between; gap: 1rem;
    padding: .8rem 0; border-bottom: 1px solid var(--line); font-size: .95rem; }
  .addons li:last-child { border-bottom: 0; }
  .addons__p { color: var(--rock); font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
